evals/results/
evals/*.verify
*-workspace/

# Facilitator material must never sit at the repo root.
# The tracked copy lives at warehouse/facilitator/GROUND_TRUTH.md; a stray root
# copy would publish the workshop answer key to anyone who clones.
/GROUND_TRUTH.md
