# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/

# Data artifacts
# The warehouse .duckdb file IS committed (6.8MB) — it's the point of the repo.
# Write-ahead logs and intermediate exports are not.
*.duckdb.wal
*.parquet

# Eval run outputs
evals/results/
evals/*.verify
*-workspace/

# Facilitator material must never sit at the repo root.
# The tracked copy lives at warehouse/facilitator/GROUND_TRUTH.md; a stray root
# copy would publish the workshop answer key to anyone who clones.
/GROUND_TRUTH.md

# Overlay instructions, not part of the repo
APPLY-THIS.txt

# Generated deck — rebuild with: cd workshop && node build_deck.js
vibe-analytics-workshop.pptx

# Workshop participant scratch files -- per-laptop, not meant to be committed.
# references/<domain>.md is intentionally NOT here: that file is meant to
# become a real PR in the Contribute block.
evals/my-eval.json
workshop/my-ablation-*.json
